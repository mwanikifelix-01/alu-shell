#!/usr/bin/env bash
# This script manages manage_my_process

fpid="/var/run/my_process.pid"
case "$1" in
	start)
	     ./manage_my_process &
	     echo $! > "$fpid"
	     echo "manage_my_process started"
	     ;;
	stop)
  	     if [ -f "$fpid" ]; then
	         pkill -f manage_my_process
	         rm -f "$fpid"
	     fi
	         echo "manage_my_process stoppe"
             ;;
 	restart)
	  if [ -f "$fpid" ]; then
	     pkill -f manage_my_process
	     rm -f "$fpid"
	  fi
	     ./manage_my_process &
	     echo $! > "$fpid"
	     echo "manage_my_process restarted"
	     ;;
 	*)
	  echo "Usage: manage_my_process {start|stop|restart}"
	  exit 1
	  ;;
esac 
